<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Globalization stays on. WPF resolves a specific culture for every binding, and with
      InvariantGlobalization it throws "Cannot find non-neutral culture related to 'en-us'" the
      moment a window is shown. The UI also ships in two languages, so culture data is needed
      rather than merely tolerated.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Authors>CaYaDev</Authors>
    <Product>CaYaTunnel</Product>
    <Company>CaYaDev</Company>
    <Copyright>Copyright (c) CaYaDev</Copyright>
    <RepositoryUrl>https://github.com/CaYatur/CaYaTunnel</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
