<Window x:Class="CaYaTunnel.Server.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CaYaTunnel.Ui"
        xmlns:vm="clr-namespace:CaYaTunnel.Server.App.ViewModels"
        Title="CaYaTunnel Server"
        Width="1120" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        UseLayoutRounding="True">

  <Window.Resources>
    <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:StringToVisibilityConverter x:Key="StringToVisibility" />
    <ui:CountToVisibilityConverter x:Key="CountToVisibility" />
    <ui:EqualityToVisibilityConverter x:Key="PageVisibility" />
    <ui:PageSelectionConverter x:Key="PageSelection" />
  </Window.Resources>

  <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Rectangle Fill="{StaticResource HeroGlowBrush}" Height="360" VerticalAlignment="Top" IsHitTestVisible="False" />

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CAYA" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="TUNNEL" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Style="{StaticResource Pill}" Background="{StaticResource AccentWashBrush}" Margin="10,0,0,0">
              <TextBlock Text="SERVER" Style="{StaticResource MonoText}" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource Pill}" Padding="12,5" Background="{StaticResource SurfaceRaisedBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding GatewayStatusLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Config.ServerName}" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimise_Click" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Navigation -->
          <StackPanel Grid.Column="0" Margin="12,6,6,12">
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Overview}" Content="{ui:L NavOverview}" />
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Tunnels}" Content="{ui:L NavTunnels}" />
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Devices}" Content="{ui:L NavDevices}" />
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Clients}" Content="{ui:L NavClients}" />
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Log}" Content="{ui:L NavLog}" />
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                         IsChecked="{Binding PageName, Mode=TwoWay, Converter={StaticResource PageSelection}, ConverterParameter=Settings}" Content="{ui:L NavSettings}" />

            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="6,14,6,14" />

            <Button Style="{StaticResource PrimaryButton}" Margin="4,0,4,6" Content="{ui:L StartGateway}"
                    Command="{Binding StartGatewayCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="4,0,4,6" Content="{ui:L StopGateway}"
                    Command="{Binding StopGatewayCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <Grid Grid.Column="1" Margin="6,0,18,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Message strip -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource OnlineWashBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource OnlineBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                      <Setter Property="Background" Value="{StaticResource DangerWashBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
            </Border>

            <!-- ==== Overview ==== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Overview}">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{ui:L OverviewTitle}" Style="{StaticResource TitleText}" Margin="0,0,0,14" />

                <UniformGrid Columns="4" Margin="0,0,0,18">
                  <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                      <TextBlock Text="{Binding OnlineDeviceCount}" Style="{StaticResource BodyText}"
                                 FontSize="{StaticResource FontSizeHero}" FontFamily="{StaticResource DisplayFont}" />
                      <TextBlock Text="{ui:L ConnectedDevices}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                      <TextBlock Text="{Binding TunnelCount}" Style="{StaticResource BodyText}"
                                 FontSize="{StaticResource FontSizeHero}" FontFamily="{StaticResource DisplayFont}" />
                      <TextBlock Text="{ui:L TotalTunnels}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                      <TextBlock Text="{Binding ActiveConnectionCount}" Style="{StaticResource BodyText}"
                                 FontSize="{StaticResource FontSizeHero}" FontFamily="{StaticResource DisplayFont}"
                                 Foreground="{StaticResource OnlineBrush}" />
                      <TextBlock Text="{ui:L Connections}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                      <TextBlock Text="{Binding DeviceCount}" Style="{StaticResource BodyText}"
                                 FontSize="{StaticResource FontSizeHero}" FontFamily="{StaticResource DisplayFont}" />
                      <TextBlock Text="{ui:L NavDevices}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <!-- What to forward, and what to hand out -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="{ui:L ControlPortLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ControlEndpoint}" Style="{StaticResource MonoText}"
                               FontSize="{StaticResource FontSizeLarge}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{ui:L ControlPortHint}" Style="{StaticResource FieldHint}" />

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16" />

                    <TextBlock Text="{ui:L CertificateFingerprint}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding CertificateFingerprint}" Style="{StaticResource MonoText}"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Style="{StaticResource LinkButton}" Content="{ui:L Copy}" Margin="0,6,0,0"
                            Command="{Binding CopyFingerprintCommand}" />

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16" />

                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{ui:L EnrollmentKeyLabel}" Style="{StaticResource FieldLabel}" />
                      <TextBlock Text="{Binding KeyGenerationLabel}" Style="{StaticResource MutedText}"
                                 Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding EnrollmentKeyDisplay}" Style="{StaticResource MonoText}"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Style="{StaticResource LinkButton}" Command="{Binding ToggleKeyCommand}" Margin="0,0,14,0">
                        <TextBlock>
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="{ui:L RevealKey}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding KeyRevealed}" Value="True">
                                  <Setter Property="Text" Value="{ui:L HideKey}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                      <Button Style="{StaticResource LinkButton}" Content="{ui:L Copy}" Margin="0,0,14,0"
                              Command="{Binding CopyKeyCommand}" />
                      <Button Style="{StaticResource LinkButton}" Content="{ui:L RotateKey}"
                              Foreground="{StaticResource DangerBrush}" Command="{Binding RotateKeyCommand}" />
                    </StackPanel>
                    <TextBlock Text="{ui:L RotateKeyHint}" Style="{StaticResource FieldHint}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- ==== Tunnels ==== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Tunnels}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{ui:L TunnelsTitle}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{ui:L TunnelsSubtitle}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
              </StackPanel>

              <ListBox Grid.Row="1" Style="{StaticResource CardList}" ItemsSource="{Binding Tunnels}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ServerTunnelRow}">
                    <Grid Margin="16,13">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                          <Border Style="{StaticResource Pill}" Background="{Binding StatusWashBrush}" Padding="7,2">
                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource MonoText}" FontSize="10"
                                       FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                          </Border>
                          <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                     Margin="9,0,0,0" VerticalAlignment="Center" />
                          <Border Style="{StaticResource Pill}" Background="{StaticResource SurfaceHoverBrush}" Margin="9,0,0,0">
                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource MutedText}" FontSize="10" />
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MonoText}"
                                     Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="→" Style="{StaticResource MutedText}" Margin="9,0" />
                          <TextBlock Text="{Binding TargetEndpoint}" Style="{StaticResource MonoText}"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                          <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}"
                                     Foreground="{Binding StatusBrush}" />
                          <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="7,0" />
                          <TextBlock Text="{Binding Traffic}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{ui:L Edit}"
                                Command="{Binding DataContext.EditTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.ToggleTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                          <TextBlock>
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ui:L Disable}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Text" Value="{ui:L Enable}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{ui:L Delete}"
                                Foreground="{StaticResource DangerBrush}"
                                Command="{Binding DataContext.DeleteTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- ==== Devices ==== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Devices}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{ui:L DevicesTitle}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{ui:L DevicesSubtitle}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
              </StackPanel>

              <ListBox Grid.Row="1" Style="{StaticResource CardList}" ItemsSource="{Binding Devices}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ServerDeviceRow}">
                    <Grid Margin="16,13">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                          <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                          <Border Style="{StaticResource Pill}" Background="{StaticResource SurfaceHoverBrush}" Margin="9,0,0,0">
                            <TextBlock Text="{Binding KeyKindLabel}" Style="{StaticResource MutedText}" FontSize="10" />
                          </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,8,0,0">
                          <TextBlock Text="{Binding RemoteAddress}" Style="{StaticResource MonoText}"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                          <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="7,0" />
                          <TextBlock Text="{Binding LocalAddresses}" Style="{StaticResource MonoText}"
                                     Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,5,0,0">
                          <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}"
                                     Foreground="{Binding StatusBrush}" />
                          <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="7,0" />
                          <TextBlock Text="{Binding TunnelCount}" Style="{StaticResource MutedText}" />
                          <TextBlock Text="{ui:L TunnelCount}" Style="{StaticResource MutedText}" Margin="4,0,0,0" />
                          <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="7,0" />
                          <TextBlock Text="{Binding Latency}" Style="{StaticResource MutedText}" />
                          <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="7,0" />
                          <TextBlock Text="{Binding LastSeen}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{ui:L Approve}"
                                Command="{Binding DataContext.ApproveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding PendingApproval, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                          <TextBlock>
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ui:L Revoke}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Revoked}" Value="True">
                                    <Setter Property="Text" Value="{ui:L Restore}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{ui:L Remove}"
                                Foreground="{StaticResource DangerBrush}"
                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- ==== Client builds ==== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Clients}">
              <ContentControl Content="{Binding ClientBuilder}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type vm:ClientBuilderViewModel}">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{ui:L ClientBuildsTitle}" Style="{StaticResource TitleText}" />
                      <TextBlock Text="{ui:L ClientBuildsSubtitle}" Style="{StaticResource SecondaryText}"
                                 Margin="0,3,0,16" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />

                      <Border Style="{StaticResource Card}">
                        <StackPanel>
                          <TextBlock Text="Client template" Style="{StaticResource FieldLabel}" />
                          <TextBlock Text="{Binding StubPathLabel}" Style="{StaticResource MonoText}"
                                     TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                          <Button Style="{StaticResource LinkButton}" Content="{ui:L ImportStub}" Margin="0,6,0,0"
                                  Command="{Binding ChooseStubCommand}" />

                          <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16" />

                          <TextBlock Text="{ui:L BuildForDevice}" Style="{StaticResource FieldLabel}" />
                          <ComboBox Style="{StaticResource FieldCombo}" ItemContainerStyle="{StaticResource FieldComboItem}"
                                    ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}"
                                    Width="320" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Display}" Style="{StaticResource BodyText}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{ui:L BuildGenericHint}" Style="{StaticResource FieldHint}" />

                          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{ui:L BuildClient}"
                                    Command="{Binding BuildCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="{ui:L ShowInFolder}" Margin="10,0,0,0"
                                    Command="{Binding ShowInFolderCommand}"
                                    Visibility="{Binding HasBuilt, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>

                          <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </ScrollViewer>

            <!-- ==== Activity ==== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Log}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{ui:L ActivityTitle}" Style="{StaticResource TitleText}" />
                <Button Style="{StaticResource GhostButton}" Content="{ui:L ClearLog}" HorizontalAlignment="Right"
                        Command="{Binding ClearLogCommand}" />
              </Grid>

              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding LogEntries}" Background="Transparent">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="10,4" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                              <ContentPresenter />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>

            <!-- ==== Settings ==== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding PageName, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}">
              <ContentControl Content="{Binding Settings}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type vm:ServerSettingsViewModel}">
                    <StackPanel Margin="0,0,10,0">

                      <TextBlock Text="{ui:L SectionPublic}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <TextBlock Text="{ui:L FieldServerName}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}" Margin="0,0,0,12"
                                   Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" />

                          <TextBlock Text="{ui:L FieldPublicHost}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}"
                                   Text="{Binding PublicHost, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text="{ui:L FieldPublicHostHint}" Style="{StaticResource FieldHint}" Margin="0,5,0,12" />

                          <TextBlock Text="{ui:L FieldBaseDomain}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}"
                                   Text="{Binding BaseDomain, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text="{ui:L FieldBaseDomainHint}" Style="{StaticResource FieldHint}" Margin="0,5,0,12" />

                          <TextBlock Text="{ui:L ControlPortLabel}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}" Width="140" HorizontalAlignment="Left"
                                   Text="{Binding ControlPort, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text="{ui:L ControlPortHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionListeners}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L SinglePortMode}"
                                    IsChecked="{Binding SinglePortMode}" />
                          <TextBlock Text="{ui:L SinglePortModeHint}" Style="{StaticResource FieldHint}" />

                          <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16" />

                          <StackPanel Visibility="{Binding ShowsIndividualListeners, Converter={StaticResource BoolToVisibility}}">
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L EnableHttpRouter}"
                                    IsChecked="{Binding EnableHttpRouter}" Margin="0,0,0,12" />
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,14,0">
                              <TextBlock Text="{ui:L FieldHttpPort}" Style="{StaticResource FieldLabel}" />
                              <TextBox Style="{StaticResource FieldInput}" Width="120"
                                       Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                              <TextBlock Text="{ui:L FieldHttpsPort}" Style="{StaticResource FieldLabel}" />
                              <TextBox Style="{StaticResource FieldInput}" Width="120"
                                       Text="{Binding HttpsPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                          </StackPanel>

                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L EnableMinecraftRouter}"
                                    IsChecked="{Binding EnableMinecraftRouter}" Margin="0,0,0,12" />
                          <TextBlock Text="{ui:L FieldMinecraftPort}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}" Width="120" HorizontalAlignment="Left"
                                   Margin="0,0,0,14"
                                   Text="{Binding MinecraftPort, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>

                          <TextBlock Text="{ui:L FieldPortRange}" Style="{StaticResource FieldLabel}" />
                          <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource FieldInput}" Width="120"
                                     Text="{Binding PortRangeStart, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="–" Style="{StaticResource MutedText}" Margin="10,0" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource FieldInput}" Width="120"
                                     Text="{Binding PortRangeEnd, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <TextBlock Text="{ui:L FieldPortRangeHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionPublicTls}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <TextBlock Text="{ui:L PublicTlsHint}" Style="{StaticResource FieldHint}" Margin="0,0,0,12" />
                          <TextBlock Text="{Binding PublicTlsCertificateSummary}" Style="{StaticResource MutedText}"
                                     TextWrapping="Wrap" Margin="0,0,0,12" />
                          <TextBlock Text="{ui:L PublicTlsPassword}" Style="{StaticResource FieldLabel}" />
                          <TextBox Style="{StaticResource FieldInput}" Width="280" HorizontalAlignment="Left"
                                   Text="{Binding PublicTlsCertificatePassword, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text="{ui:L PublicTlsPasswordHint}" Style="{StaticResource FieldHint}" Margin="0,5,0,12" />
                          <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="{ui:L ImportPublicTlsCertificate}"
                                    Command="{Binding ImportPublicTlsCommand}" Margin="0,0,10,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{ui:L ImportPublicTlsPemButton}"
                                    Command="{Binding ImportPublicTlsPemCommand}" Margin="0,0,10,8" />
                            <Button Style="{StaticResource LinkButton}" Content="{ui:L ClearPublicTlsCertificate}"
                                    Command="{Binding ClearPublicTlsCommand}" Margin="0,0,0,8"
                                    Visibility="{Binding HasImportedPublicTlsCertificate, Converter={StaticResource BoolToVisibility}}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionDns}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <TextBlock Text="{ui:L DnsProvider}" Style="{StaticResource FieldLabel}" />
                          <ComboBox Style="{StaticResource FieldCombo}" ItemContainerStyle="{StaticResource FieldComboItem}"
                                    SelectedIndex="{Binding DnsProviderIndex}" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{ui:L DnsManual}" />
                            <ComboBoxItem Content="Cloudflare" />
                          </ComboBox>
                          <TextBlock Text="{ui:L DnsManualHint}" Style="{StaticResource FieldHint}"
                                     Visibility="{Binding IsCloudflare, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                          <StackPanel Visibility="{Binding IsCloudflare, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,14,0,0">
                            <TextBlock Text="{ui:L CloudflareToken}" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource MonoFieldInput}"
                                     Text="{Binding CloudflareToken, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{ui:L CloudflareTokenHint}" Style="{StaticResource FieldHint}" Margin="0,5,0,12" />

                            <TextBlock Text="{ui:L CloudflareZoneId}" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource MonoFieldInput}" Margin="0,0,0,12"
                                     Text="{Binding CloudflareZoneId, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L ProxyRecords}"
                                      IsChecked="{Binding ProxyRecords}" />
                            <TextBlock Text="{ui:L ProxyRecordsHint}" Style="{StaticResource FieldHint}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                              <Button Style="{StaticResource SecondaryButton}" Content="{ui:L TestConnection}"
                                      Command="{Binding TestDnsCommand}" />
                              <TextBlock Text="{Binding DnsStatus}" Style="{StaticResource SecondaryText}"
                                         VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"
                                         Visibility="{Binding DnsStatus, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionFirewall}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <TextBlock Text="{ui:L FirewallHint}" Style="{StaticResource SecondaryText}"
                                     TextWrapping="Wrap" Margin="0,0,0,12" />

                          <TextBlock Text="{ui:L FirewallWillOpen}" Style="{StaticResource FieldLabel}" />
                          <TextBlock Text="{Binding FirewallPlan}" Style="{StaticResource MonoText}"
                                     Foreground="{StaticResource TextSecondaryBrush}" />

                          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{ui:L FirewallApply}"
                                    Command="{Binding ApplyFirewallCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{ui:L FirewallRemove}"
                                    Command="{Binding RemoveFirewallCommand}" />
                          </StackPanel>

                          <TextBlock Text="{ui:L FirewallNeedsAdmin}" Style="{StaticResource FieldHint}"
                                     Foreground="{StaticResource WarningBrush}"
                                     Visibility="{Binding CanManageFirewall, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionSecurity}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L RequireApproval}"
                                    IsChecked="{Binding RequireApproval}" />
                          <TextBlock Text="{ui:L RequireApprovalHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionStartup}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L AutoStartGateway}"
                                    IsChecked="{Binding AutoStartGateway}" Margin="0,0,0,12" />
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L StartWithWindows}"
                                    IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
                          <CheckBox Style="{StaticResource SwitchToggle}" Content="{ui:L StartElevated}"
                                    IsChecked="{Binding StartElevated}" />
                          <TextBlock Text="{ui:L StartElevatedHint}" Style="{StaticResource FieldHint}" />

                          <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16" />

                          <TextBlock Text="{ui:L RunAsService}" Style="{StaticResource FieldLabel}" />
                          <TextBlock Text="{Binding ServiceStatusLabel}" Style="{StaticResource MutedText}" />
                          <TextBlock Text="{ui:L RunAsServiceHint}" Style="{StaticResource FieldHint}" />
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{ui:L InstallService}"
                                    Command="{Binding InstallServiceCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource DangerButton}" Content="{ui:L UninstallService}"
                                    Command="{Binding UninstallServiceCommand}"
                                    Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Restart as administrator"
                                    Margin="14,0,0,0" Command="{Binding RelaunchElevatedCommand}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{ui:L SectionApplication}" Style="{StaticResource SectionLabel}" />
                      <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                          <TextBlock Text="{ui:L Language}" Style="{StaticResource FieldLabel}" />
                          <ComboBox Style="{StaticResource FieldCombo}" ItemContainerStyle="{StaticResource FieldComboItem}"
                                    SelectedIndex="{Binding LanguageIndex}" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{ui:L LanguageSystem}" />
                            <ComboBoxItem Content="{ui:L LanguageTurkish}" />
                            <ComboBoxItem Content="{ui:L LanguageEnglish}" />
                          </ComboBox>
                        </StackPanel>
                      </Border>

                      <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Style="{StaticResource PrimaryButton}" Content="{ui:L Save}" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
