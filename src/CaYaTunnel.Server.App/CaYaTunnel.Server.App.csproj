<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CaYaTunnel.Server.App</RootNamespace>
    <AssemblyName>CaYaTunnelServer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms is referenced only for the tray icon; the UI itself is entirely WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!--
      A custom entry point, because this executable has two jobs: the admin window, and a
      headless Windows service. App.xaml is therefore a Page rather than the ApplicationDefinition
      so the generated Main does not take over.
    -->
    <StartupObject>CaYaTunnel.Server.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- See the client app: WinForms' implicit usings collide with WPF on Brush and friends. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaYaTunnel.Core\CaYaTunnel.Core.csproj" />
    <ProjectReference Include="..\CaYaTunnel.Server\CaYaTunnel.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\Mvvm\*.cs" Link="Shared\%(Filename).cs" />
    <Compile Include="..\..\shared\Windows\*.cs" Link="Shared\%(Filename).cs" />
    <Compile Include="..\..\shared\Localization\*.cs" Link="Shared\%(Filename).cs" />
    <Compile Include="..\..\shared\Preview\*.cs" Link="Shared\%(Filename).cs" />
    <Page Include="..\..\shared\Theme\*.xaml" Link="Theme\%(Filename).xaml" />
  </ItemGroup>

</Project>
